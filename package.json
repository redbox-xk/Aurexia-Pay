{
  "name": "aurexia-pay",
  "version": "1.0.0",
  "description": "Aurexia Pay - Blockchain Payment Platform",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && go build -o ../build/aurexia-backend ./cmd/api-gateway",
    "build:frontend": "cd frontend && npm run build",
    "build:consensus": "./scripts/build/build-consensus.sh",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && go run cmd/api-gateway/main.go",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "docker-compose up",
    "test": "npm run test:backend && npm run test:frontend",
    "deploy": "npm run build && ./scripts/deploy/deploy-l1.sh",
    "init": "./scripts/init/init-node.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Aurexia Team",
  "license": "MIT"
}
