# Frontend Environment Variables - Copy to .env.local

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

# Web3 Configuration (Optional - automatically detects MetaMask)
NEXT_PUBLIC_INFURA_ID=your_infura_id_here
NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_id_here

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NFC=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=true

# Authentication
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Deployment
NODE_ENV=development
